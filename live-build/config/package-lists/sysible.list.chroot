# Headless Sysible Workstation base. The full Sysible toolkit (CLI/devops tools) is
# pulled in via the sysible-* packages in config/packages.chroot and the toolkit
# list generated by build.sh; this file carries only the live/boot plumbing and
# the server essentials every image needs.

# Live boot + config plumbing (needed to boot the ISO and the live session).
live-boot
live-config
live-config-systemd

# VM guest integration (clipboard, folder sharing, graceful shutdown) — the
# headless daemon only, no desktop component. Sysible Workstation commonly runs in a VM.
open-vm-tools
# qemu-guest-agent is the KVM/QEMU equivalent (host<->guest agent, clean shutdown).
qemu-guest-agent

# net-tools guarantees ifconfig/route are present (their PATH is fixed via
# /etc/profile.d/sysible-path.sh).
net-tools

# --- server essentials ---------------------------------------------------
# Remote administration, privilege, and trust.
openssh-server
sudo
ca-certificates
gnupg
# Fetching artifacts / talking to APIs.
curl
wget
rsync
# Everyday console tooling.
vim
less
htop
bash-completion
# Time sync for a server that must keep accurate clocks.
chrony
# Automatic security updates on an unattended box.
unattended-upgrades
# Cloud-init style disk/partition growth helpers for VM/cloud images.
cloud-guest-utils
# System message bus — required by many services and by systemd tooling.
dbus
# Headless split terminal (Ctrl+a prefix; F2/F3/F4 AND Ctrl+F1/F2/F4 on the
# console — the latter via the console-splitkeys keymap). Listed explicitly so
# it's always installed, not only via the generated toolkit list.
tmux
# loadkeys — loads the console keymap that makes Ctrl+F1/F2/F4 reach tmux at the
# raw VT (sysible-console-splitkeys.service). Usually pulled in by console-setup,
# listed explicitly so the split keys never silently break if that changes.
kbd
