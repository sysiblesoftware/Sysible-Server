# Headless Sysible Server base. The full Sysible toolkit (CLI/devops tools) is
# pulled in via the sysible-* packages in config/packages.chroot and the toolkit
# list generated by build.sh; this file carries only the live/boot plumbing and
# the server essentials every image needs.

# Live boot + config plumbing (needed to boot the ISO and the live session).
live-boot
live-config
live-config-systemd

# VM guest integration (clipboard, folder sharing, graceful shutdown) — the
# headless daemon only, no desktop component. Sysible Server commonly runs in a VM.
open-vm-tools
# qemu-guest-agent is the KVM/QEMU equivalent (host<->guest agent, clean shutdown).
qemu-guest-agent

# net-tools guarantees ifconfig/route are present (their PATH is fixed via
# /etc/profile.d/sysible-path.sh).
net-tools

# --- server essentials ---------------------------------------------------
# Remote administration, privilege, and trust.
openssh-server
sudo
ca-certificates
gnupg
# SSH hardening that backs the shipped configs (otherwise those files are inert):
#   fail2ban         -> etc/fail2ban/jail.d/sysible.local  (bans brute-force sshd)
#   libpam-pwquality -> etc/security/pwquality.conf.d/*    (rejects weak passwords)
fail2ban
libpam-pwquality
# Fetching artifacts / talking to APIs.
curl
wget
rsync
# Everyday console tooling.
vim
less
htop
bash-completion
# Time sync for a server that must keep accurate clocks.
chrony
# Automatic security updates on an unattended box.
unattended-upgrades
# Cloud-init style disk/partition growth helpers for VM/cloud images.
cloud-guest-utils
# System message bus — required by many services and by systemd tooling.
dbus
# Terminal multiplexer — available if a user chooses to run it, but NOT started
# automatically on login (each SSH session gets its own plain shell).
tmux
# Console keymap/font tooling. Usually pulled in by console-setup; listed
# explicitly so it's always present.
kbd
