# Sysible fail2ban defaults. SSH is ENABLED by default on Sysible Server, so this
# jail is active out of the box: brute-force sources hitting sshd get banned.
# SSH accepts password login by default (no baked credential; the install-time
# password is user-chosen), so this jail is a front-line defense: it bans
# brute-force sources and invalid users hitting sshd.
# Requires the fail2ban package (shipped in the chroot package list). Reads the
# systemd journal.
[DEFAULT]
backend = systemd
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
