[Unit]
Description=Install operator-selected optional tools on first boot
Documentation=https://sysible.com
# Only when the installer recorded a selection. install-selected-tools deletes
# the file when finished, so this is a one-shot on the first networked boot and
# is skipped on every boot thereafter.
ConditionPathExists=/etc/sysible/tools.wanted
# The tools download from vendor repos, so wait for the network to be up.
Wants=network-online.target
After=network-online.target

# NOT before the login prompt. These are the optional, separately licensed
# tools (terraform, vault, consul, aws-cli) and they are downloaded from the
# vendors, so this step is as slow and as fallible as whatever network the
# machine is on. The platform is what has to be up at the prompt; this is not.
# It runs AFTER the apps, so two apt/dpkg jobs still never race for the lock.
After=sysible-apps-firstboot.service

[Service]
# Same reason as sysible-apps-firstboot: installing vendor packages is a
# minutes-long job and must not hold multi-user.target open, which is what
# keeps systemd printing unit status over an operator's shell.
# Same as sysible-apps-firstboot: finish before anyone can log in, so the
# machine is in its final state at the prompt rather than changing underneath
# someone who is already using it.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/lib/sysible/install-selected-tools

[Install]
WantedBy=multi-user.target
