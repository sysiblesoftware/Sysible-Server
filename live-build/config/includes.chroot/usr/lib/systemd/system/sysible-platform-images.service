[Unit]
Description=Load the Sysible platform container images into Docker
Documentation=https://sysible.com/server-manual.html
# The whole point is to be usable on a host with no registry access, so this must
# not want the network. It needs the daemon and nothing else.
After=docker.service
Requires=docker.service
ConditionPathExists=/usr/share/sysible/app-images
ConditionPathExists=!/var/lib/sysible/platform-images-loaded

[Service]
Type=oneshot
RemainAfterExit=yes
# BOUNDED, because sysible-apps-firstboot is ordered After= this unit and that
# unit gates the login prompt. An unbounded load here would therefore hold the
# prompt open for ever, which is exactly the lockout the cap on that unit
# exists to prevent -- a cap is worth nothing if the thing in front of it has
# none. Loading several hundred megabytes of layers is not quick on slow
# storage, so this is generous; past it, systemd gives up, the unit fails, and
# the apps unit's own checks report the images as missing rather than hanging.
TimeoutStartSec=150
ExecStart=/usr/lib/sysible/load-platform-images

[Install]
WantedBy=multi-user.target
