[Unit]
Description=Install the Sysible apps chosen during the install, on first boot
Documentation=https://sysible.com
# Only when the installer recorded a selection. install-selected-apps removes
# the file once it succeeds (or once it has given up), so this is a one-shot on
# the first networked boot and is skipped on every boot thereafter.
ConditionPathExists=/etc/sysible/apps.wanted
# Wanted, NOT required: an edition that ships the platform images and source
# installs with no route out at all, and this must still run there. It is only
# a host that has to clone from GitHub and build from Docker Hub that needs the
# network, so waiting for it is an optimisation, never a precondition.
Wants=network-online.target
After=network-online.target docker.service
# NOT after the tools unit any more. This one gates the login prompt, so
# anything it waits for gates the prompt too -- and the optional licensed tools
# download from vendor repos, which can be slow or unreachable and have nothing
# to do with getting the platform running. The ordering is reversed instead:
# sysible-tools-firstboot runs After= THIS unit, so the dpkg lock is still never
# contended and the slow, optional half happens once you are already logged in.
# The platform images must be in Docker's store BEFORE compose runs, or it
# goes to a registry for images this machine already carries -- which on an
# airgapped host means the install fails at the very last step.
After=sysible-platform-images.service
Wants=sysible-platform-images.service

# Gate the login prompt on this. systemd-user-sessions.service is what
# lifts the login block, so ordering before it means nothing can log in
# until setup has finished -- which is the whole point: the machine is in
# its final state at the prompt, instead of changing underneath someone
# who is already using it.
Before=systemd-user-sessions.service

[Service]
# BEFORE THE LOGIN PROMPT, not after it.
#
# This was Type=oneshot, then briefly Type=simple to stop systemd painting unit
# status over a shell someone had already logged into. That fixed the noise and
# missed the point: the complaint was never really about the scrolling, it was
# that you log in, the platform is not there, `sysiblectl slop start` says it is
# not installed, and then containers start up around you. Setup belongs before
# the prompt, so that by the time you can type, the platform is running.
#
# Ordering before systemd-user-sessions.service is what does that: it is the
# unit that lifts the login block, so nothing can log in until this finishes.
# The console output is deliberate now -- a machine that sits for two minutes
# with no explanation looks hung, so it says what it is doing.
#
# BOUNDED, unlike before. Gating logins on an unbounded job means one wedged
# install locks the operator out of their own machine with no way back. Five
# minutes is well beyond a normal run -- the images ship in the ISO and are
# already loaded by this point, so there is nothing to pull and nothing to
# build. Past that, systemd gives up, the unit fails, the login prompt appears,
# and the script's own retry/apps-failed path and the login hint take over.
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=150
ExecStart=/usr/lib/sysible/install-selected-apps

[Install]
WantedBy=multi-user.target
