[Unit]
Description=Install the Sysible apps chosen during the install, on first boot
Documentation=https://sysible.com
# Only when the installer recorded a selection. install-selected-apps removes
# the file once it succeeds (or once it has given up), so this is a one-shot on
# the first networked boot and is skipped on every boot thereafter.
ConditionPathExists=/etc/sysible/apps.wanted
# Wanted, NOT required: an edition that ships the platform images and source
# installs with no route out at all, and this must still run there. It is only
# a host that has to clone from GitHub and build from Docker Hub that needs the
# network, so waiting for it is an optimisation, never a precondition.
Wants=network-online.target
After=network-online.target docker.service
# The tools the operator picked (terraform, kubectl, ...) install from vendor apt
# repos. Ordering after that unit keeps two long apt/network jobs off each
# other's back on the very first boot rather than racing for dpkg's lock.
After=sysible-tools-firstboot.service
# The platform images must be in Docker's store BEFORE compose runs, or it
# goes to a registry for images this machine already carries -- which on an
# airgapped host means the install fails at the very last step.
After=sysible-platform-images.service
Wants=sysible-platform-images.service

[Service]
# NOT oneshot. multi-user.target waits for a oneshot unit to finish, and this
# one clones nothing but does build and start containers -- minutes. Until the
# target is reached systemd keeps painting unit status on the console, so an
# operator who had already logged in watched "Started docker-<hash>.scope" lines
# scroll over their shell prompt and reasonably asked what was going wrong.
#
# Type=simple marks the unit active as soon as the process starts, so boot
# completes, systemd stops writing to the console, and the install carries on in
# the background. The script still reports its own result to the journal, still
# writes /etc/sysible/apps-failed when it gives up, and still logs in full to
# /var/log/sysible-apps-firstboot.log.
#
# RemainAfterExit is meaningless for Type=simple and is gone: re-running is
# already prevented by ConditionPathExists above, since the script removes
# apps.wanted once it has succeeded or given up.
Type=simple
# The work writes to its own log; nothing from it belongs on the console.
StandardOutput=journal
StandardError=journal
ExecStart=/usr/lib/sysible/install-selected-apps
# Cloning four repos and building containers is not a 90-second job.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
