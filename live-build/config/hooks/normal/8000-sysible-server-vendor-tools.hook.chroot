#!/bin/sh
# Install the non-Debian server tools that make Sysible Server "everything on
# first boot": Docker CE + kubectl from their official apt repos, and Helm,
# OpenTofu, k9s and SOPS from their official release binaries. Runs in the chroot
# with network. Self-contained — it wires up the vendor apt repos itself, so this
# repo has no dependency on the Sysible Workstation packages.
set -e
export DEBIAN_FRONTEND=noninteractive
echo "== Sysible Server: installing vendor tools =="

CURL="curl -fsSL --connect-timeout 20 --max-time 600 --retry 3 --retry-delay 3"

# Verify a download against the checksum its upstream publishes. FAIL CLOSED on a
# mismatch; WARN + continue if the checksum file itself can't be fetched (TLS
# already protected the download). Usage: verify_sha256 <file> <url> [<name>]
verify_sha256() {
    _f="$1"; _url="$2"; _name="$3"
    _sums=$($CURL "$_url" 2>/dev/null) || { echo "   WARN: checksum $_url unfetchable — skipping check for $_f"; return 0; }
    if [ -n "$_name" ]; then
        _want=$(printf '%s\n' "$_sums" | grep -E "[[:space:]]\*?${_name}\$" | grep -oE '^[0-9a-fA-F]{64}' | head -1)
    else
        _want=$(printf '%s\n' "$_sums" | grep -oE '[0-9a-fA-F]{64}' | head -1)
    fi
    [ -n "$_want" ] || { echo "   WARN: no checksum for ${_name:-$_f} — skipping"; return 0; }
    _got=$(sha256sum "$_f" | awk '{print $1}')
    if [ "$_got" = "$_want" ]; then echo "   sha256 OK: $_got"; else
        echo "FATAL: checksum mismatch for $_f (got $_got, want $_want)" >&2; exit 1; fi
}

ARCH=$(dpkg --print-architecture)          # amd64 | arm64
case "$ARCH" in
    amd64) GNU_ARCH=x86_64 ;;
    arm64) GNU_ARCH=aarch64 ;;
    *) echo "Unsupported arch: $ARCH" >&2; exit 1 ;;
esac
echo "-- building for $ARCH ($GNU_ARCH) --"

# The chroot can come up with an empty CA store — every HTTPS then fails. Rebuild
# it (and trust any operator CA dropped in for inspected networks) before HTTPS.
apt-get install -y --reinstall ca-certificates >/dev/null 2>&1 \
    || apt-get install -y ca-certificates >/dev/null 2>&1 || true
update-ca-certificates --fresh >/dev/null 2>&1 || update-ca-certificates || true
if ! curl -fsS --connect-timeout 20 --max-time 60 -o /dev/null https://download.docker.com/linux/debian/gpg; then
    echo "FATAL: HTTPS fails to verify inside the chroot. Build on a clean network"
    echo "       (the GitHub Actions runner) or drop the intercepting CA into"
    echo "       live-build/config/extra-ca/ so it is trusted." >&2
    exit 1
fi

install -d -m0755 /usr/share/keyrings /etc/apt/sources.list.d
CODENAME=$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-bookworm}")

# --- Docker CE (official apt repo) ----------------------------------------
echo "== docker-ce (official apt repo) =="
$CURL https://download.docker.com/linux/debian/gpg \
    | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=${ARCH} signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian ${CODENAME} stable" \
    > /etc/apt/sources.list.d/docker.list

# --- Kubernetes kubectl (official pkgs.k8s.io repo) ------------------------
echo "== kubectl (official pkgs.k8s.io repo) =="
K8S_MINOR="v1.31"
$CURL "https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/Release.key" \
    | gpg --dearmor -o /usr/share/keyrings/kubernetes-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/kubernetes-archive-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/ /" \
    > /etc/apt/sources.list.d/kubernetes.list

apt-get update
apt-get install -y --no-install-recommends \
    docker-ce docker-ce-cli containerd.io docker-compose-plugin docker-buildx-plugin \
    kubectl
systemctl enable docker 2>/dev/null || true

# --- Helm (official binary; get.helm.sh is Google-hosted) ------------------
echo "== helm (official binary) =="
helm_ver=$($CURL https://api.github.com/repos/helm/helm/releases/latest \
    | grep -oE '"tag_name": *"v[0-9.]+"' | grep -oE 'v[0-9.]+' | head -1)
[ -n "$helm_ver" ] || helm_ver=v3.16.3
helm_tgz="https://get.helm.sh/helm-${helm_ver}-linux-${ARCH}.tar.gz"
$CURL "$helm_tgz" -o /tmp/helm.tgz
verify_sha256 /tmp/helm.tgz "${helm_tgz}.sha256sum"
tar xz -C /tmp -f /tmp/helm.tgz "linux-${ARCH}/helm"
install -m0755 "/tmp/linux-${ARCH}/helm" /usr/local/bin/helm
helm version --short || true

# --- OpenTofu (official GitHub-release binary) -----------------------------
echo "== opentofu (official binary) =="
tofu_ver=$($CURL https://api.github.com/repos/opentofu/opentofu/releases/latest \
    | grep -oE '"tag_name": *"v[0-9.]+"' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
[ -n "$tofu_ver" ] || tofu_ver=1.8.5
tofu_base="https://github.com/opentofu/opentofu/releases/download/v${tofu_ver}"
$CURL "${tofu_base}/tofu_${tofu_ver}_linux_${ARCH}.tar.gz" -o /tmp/tofu.tgz
verify_sha256 /tmp/tofu.tgz "${tofu_base}/tofu_${tofu_ver}_SHA256SUMS" "tofu_${tofu_ver}_linux_${ARCH}.tar.gz"
tar xz -C /usr/local/bin -f /tmp/tofu.tgz tofu
chmod 0755 /usr/local/bin/tofu
tofu version || true

# --- k9s + SOPS (GitHub-release binaries; best-effort, verified) -----------
echo "== k9s + sops (GitHub-release binaries) =="
if $CURL "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_${ARCH}.tar.gz" -o /tmp/k9s.tgz 2>/dev/null; then
    k9s_sum=$($CURL "https://github.com/derailed/k9s/releases/latest/download/checksums.sha256" 2>/dev/null \
        | grep -E "[[:space:]]\*?k9s_Linux_${ARCH}\.tar\.gz\$" | grep -oE '^[0-9a-fA-F]{64}' | head -1)
    if [ -z "$k9s_sum" ] || [ "$(sha256sum /tmp/k9s.tgz | awk '{print $1}')" = "$k9s_sum" ]; then
        tar xz -C /usr/local/bin -f /tmp/k9s.tgz k9s 2>/dev/null && echo "k9s ok" || echo "k9s skipped (extract)"
    else
        echo "k9s SKIPPED — checksum mismatch, not installing unverified binary"
    fi
else
    echo "k9s skipped (download)"
fi
sops_url=$($CURL https://api.github.com/repos/getsops/sops/releases/latest \
    | grep -oE "https://[^\"]*linux\.${ARCH}" | head -1)
if [ -n "$sops_url" ] && $CURL "$sops_url" -o /usr/local/bin/sops; then
    chmod +x /usr/local/bin/sops; echo "sops ok"
else
    echo "sops skipped"
fi

echo "== Sysible Server vendor tools done =="
