#!/bin/sh
# Sysible Server default identity: the unprivileged admin user 'sysible'.
# NO password is baked into the image — shipping a constant credential would
# make every install remotely guessable. Installed systems set the password
# interactively via the preseed; the live session autologs in as 'sysible'.
set -e
DEFUSER=sysible

if ! id "$DEFUSER" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "Sysible" "$DEFUSER"
fi
# Default groups deliberately EXCLUDE docker and libvirt: membership in either is
# root-equivalent (`docker run -v /:/mnt …`), so the default account must not hold
# it out of the box. Add a user to docker/libvirt via sudo only when actually
# needed. (Kept in sync with user-default-groups in auto/config.)
for g in sudo kvm netdev; do
    groupadd -f "$g" 2>/dev/null || true
    usermod -aG "$g" "$DEFUSER" 2>/dev/null || true
done
# No default credentials ship: root is LOCKED and 'sysible' has no password set.
# Expire the empty password so any interactive login on a persisted/live medium
# must set one before the shell is usable; installs get their password from the
# preseed prompt instead. SSH ships key-only (PasswordAuthentication no), and
# PermitEmptyPasswords no means the empty password is never remotely usable.
passwd -l root
passwd -d "$DEFUSER"
chage -d 0 "$DEFUSER"

# Brand the hostname.
echo sysible > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tsysible/' /etc/hosts
else
    printf '127.0.1.1\tsysible\n' >> /etc/hosts
fi
