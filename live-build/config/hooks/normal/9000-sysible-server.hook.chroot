#!/bin/sh
# Sysible Server system branding + service defaults. Headless: no desktop, no
# display manager — just a hardened console/SSH server base.
set -e

# --- os-release / issue branding ------------------------------------------
cat > /etc/os-release <<'OSREL'
PRETTY_NAME="Sysible Server"
NAME="Sysible Server"
ID=sysible
ID_LIKE=debian
VERSION="1.0.0 (Forge)"
VERSION_ID="1.0.0"
VERSION_CODENAME=forge
HOME_URL="https://sysible.com"
SUPPORT_URL="https://sysible.com"
OSREL
printf 'Sysible Server \\n \\l\n\n' > /etc/issue
echo "Sysible Server" > /etc/issue.net

# --- login banner / MOTD ---------------------------------------------------
# Debian ships a dynamic motd via /etc/update-motd.d; drop a static header so
# every login clearly identifies the box as Sysible Server.
rm -f /etc/motd
cat > /etc/motd <<'MOTD'

  Sysible Server — engineering-grade Debian server base
  Docs & support: https://sysible.com

MOTD

# --- services --------------------------------------------------------------
# Unlike the Workstation image (which ships SSH OFF for a desktop), a SERVER is
# reachable over SSH by design. Enable it; the shipped drop-in
# (/etc/ssh/sshd_config.d/10-sysible.conf) hardens it (no root login, sane
# limits). Password auth is left on so a freshly-installed box is reachable
# before keys are provisioned — switch to key-only once your keys are in place.
for svc in ssh chrony fail2ban auditd apparmor unattended-upgrades; do
    systemctl enable "$svc" 2>/dev/null || true
done

# Common admin groups exist even before any user is created.
for grp in sudo docker adm systemd-journal; do groupadd -f "$grp" 2>/dev/null || true; done

# --- unattended security upgrades -----------------------------------------
# Turn on Debian's automatic security updates (origins default to the security
# suite). Servers should self-patch security fixes out of the box.
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'AUTO'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
AUTO

echo "Sysible Server: branding + service defaults applied."
