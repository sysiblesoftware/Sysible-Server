#!/bin/sh
set -e

# os-release / issue branding. ID_LIKE=debian keeps third-party scripts happy.
cat > /etc/os-release <<OSREL
PRETTY_NAME="Sysible Server"
NAME="Sysible Server"
ID=sysible
ID_LIKE=debian
VERSION="1.0.2 (Ignition)"
VERSION_ID="1.0.2"
VERSION_CODENAME=ignition
HOME_URL="https://sysible.com"
SUPPORT_URL="https://sysible.com/controller"
LOGO=sysible-logo
OSREL
printf 'Sysible Server \\n \\l\n\n' > /etc/issue
echo "Sysible Server" > /etc/issue.net

# MOTD — remove the Debian boilerplate shown after login. Two separate sources:
#   1. /etc/motd (from base-files): "The programs included with the Debian
#      GNU/Linux system are free software ... ABSOLUTELY NO WARRANTY ..."
#   2. /etc/update-motd.d/10-uname: prints "Linux <host> 6.1.0-52-arm64 #1 SMP
#      Debian 6.1.180-1 ..." into /run/motd.dynamic, which pam_motd then shows.
# Replace (1) with a short Sysible banner and disable (2) so the kernel/Debian
# version line stops appearing. The dynamic file is cleared so the live session
# doesn't show a stale copy.
cat > /etc/motd <<'MOTD'

Sysible Server — engineering & automation server
Docs: https://sysible.com
Optional licensed tools (Terraform, Vault, Consul, …):  sudo sysible-tools

MOTD
chmod -x /etc/update-motd.d/10-uname 2>/dev/null || true
rm -f /run/motd.dynamic 2>/dev/null || true

# Enable the server-relevant daemons. SSH is enabled by default on a headless
# server (you administer it remotely); the shipped
# /etc/ssh/sshd_config.d/10-sysible.conf drop-in accepts PASSWORD login by
# default (the account password you set at install — no default credentials
# ship), so a fresh box is reachable immediately. Add a key + set
# PasswordAuthentication no there to harden an internet-facing box.
for svc in ssh libvirtd docker; do systemctl enable "$svc" 2>/dev/null || true; done
for grp in sudo kvm libvirt docker netdev; do groupadd -f "$grp" 2>/dev/null || true; done

# Never auto-suspend — a server (especially a VM) going to sleep on idle reads as
# a "freeze" and drops all its services. Mask the sleep targets at the systemd
# level so nothing can suspend/hibernate the machine. Done by hand (ln -> /dev/null)
# so it works inside the build chroot where `systemctl mask` may be a no-op.
for t in sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target; do
    ln -sf /dev/null "/etc/systemd/system/$t"
done

# GRUB entry titles: "Sysible Server", not "Sysible Server GNU/Linux".
# grub-mkconfig's /etc/grub.d/10_linux hard-codes the title as
# "${GRUB_DISTRIBUTOR} GNU/Linux"; since GRUB_DISTRIBUTOR is already the full
# product name ("Sysible Server", set in 20_sysible-theme.cfg), drop the
# " GNU/Linux" suffix entirely so the title is exactly the product name (the same
# special-casing Ubuntu does for its own entries). Idempotent, and only touches
# that exact string. The installer copies this patched file to the target and runs
# update-grub there, so the installed system's menu reads "Sysible Server"
# everywhere (main entry, "Advanced options for …", recovery).
if [ -f /etc/grub.d/10_linux ]; then
    sed -i 's|${GRUB_DISTRIBUTOR} GNU/Linux|${GRUB_DISTRIBUTOR}|g' /etc/grub.d/10_linux
fi

# Branding guard: re-assert package-owned branding (os-release, GRUB titles)
# after every apt/dpkg upgrade and on boot, so an `apt upgrade` (or
# unattended-upgrades) can't quietly revert it.
chmod 0755 /usr/lib/sysible/branding-guard 2>/dev/null || true
systemctl enable sysible-branding-guard.service 2>/dev/null || true

# Console split-terminal keys: make Ctrl+F1/F2/F4 work at the RAW Linux console
# (not just over SSH). The kernel VT can't deliver Ctrl+Fn to tmux, so a boot
# oneshot loadkeys's an incremental keymap that emits the xterm sequences tmux
# binds. See /usr/share/sysible/console-splitkeys.kmap and /etc/tmux.conf.
systemctl enable sysible-console-splitkeys.service 2>/dev/null || true

# Sysible AI shell helper: /etc/profile.d is only read by LOGIN shells, but
# interactive non-login shells (e.g. an SSH session that re-sources) read
# /etc/bash.bashrc. Source our helper from there too so `sai` and the
# failed-command hint are available in any interactive shell.
if [ -f /etc/bash.bashrc ] && ! grep -q 'profile.d/sysible-ai.sh' /etc/bash.bashrc; then
    cat >> /etc/bash.bashrc <<'BRC'

# Sysible AI terminal companion (interactive shells).
if [ -n "$PS1" ] && [ -f /etc/profile.d/sysible-ai.sh ]; then
    . /etc/profile.d/sysible-ai.sh
fi
BRC
fi
