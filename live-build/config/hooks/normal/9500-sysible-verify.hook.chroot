#!/bin/sh
# Build-time guarantee. Runs after packages are installed and FAILS the whole ISO
# build if the headless image didn't come out right: the target bootloader must be
# installable, and the Sysible boot-menu branding must match the canonical mark.
set -e

fail() { echo "SYSIBLE-VERIFY FATAL: $1" >&2; exit 1; }

# 1) The target bootloader is installable offline. grub must be INSTALLED in the
# live chroot so its .deb is in the ISO pool and already present in the unpacked
# target; otherwise the Debian Installer cannot make the installed system bootable
# on a machine with no network. Assert both the arch grub-efi package and
# update-grub are actually here.
ARCH=$(dpkg --print-architecture 2>/dev/null || echo unknown)
case "$ARCH" in
    arm64) GRUB_PKG=grub-efi-arm64 ;;
    amd64) GRUB_PKG=grub-efi-amd64 ;;
    *)     GRUB_PKG=grub-efi-amd64 ;;
esac
dpkg-query -W -f='${Status}' "$GRUB_PKG" 2>/dev/null | grep -q 'install ok installed' \
    || fail "$GRUB_PKG not installed — the installer cannot make the target bootable offline"
[ -x /usr/sbin/update-grub ] || fail "/usr/sbin/update-grub missing — grub-common not installed"
echo "sysible-verify: OK — $GRUB_PKG installed, update-grub present (target install can bootload)."

# 2) Boot-menu branding integrity. The Sysible GRUB boot-menu logo/background are
# rendered from ONE canonical mark (branding/logo/sysible-mark.svg) and their
# sha256 recorded in a manifest shipped into the image. Assert the on-disk files
# still match — this is what stops the GRUB boot logo from silently drifting back
# to old art. Env-independent: just sha256 of the committed bytes.
BMAN=/usr/share/sysible/branding.manifest
[ -f "$BMAN" ] || fail "branding manifest missing ($BMAN)"
PREFIX=live-build/config/includes.chroot
checked=0
while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    sha=${line%% *}
    rel=${line#* }
    rel=${rel# }
    # Only the assets that actually land in the installed root (under
    # includes.chroot); ISO-only splashes and repo README badges are skipped here
    # and covered by scripts/verify-branding.sh in CI instead.
    case "$rel" in
        "$PREFIX"/*) img="/${rel#"$PREFIX"/}" ;;
        *) continue ;;
    esac
    [ -f "$img" ] || fail "branded asset missing from image: $img"
    act=$(sha256sum "$img" 2>/dev/null | awk '{print $1}')
    [ "$act" = "$sha" ] || fail "branded asset drifted from the canonical mark: $img"
    checked=$((checked + 1))
done < "$BMAN"
[ "$checked" -gt 0 ] || fail "branding manifest matched no in-image assets"
echo "sysible-verify: OK — $checked branded assets match the canonical mark (incl. GRUB boot logo)."

# 2b) Boot-menu WORDING. Section 2 proves the boot menu's ARTWORK is ours; nothing
# proved its TEXT was. Every entry in the GRUB menu is literally
# GRUB_DISTRIBUTOR, and the only thing that has ever got that wrong was us: this
# repo was rebranded to "Sysible Workstation" (b0715be) and back a day later
# (8a2f18e), and the images built in between shipped a boot menu naming the wrong
# product. The build did not notice, because nothing looked.
#
# Compute the value the way grub-mkconfig does — /etc/default/grub first, then the
# drop-ins in lexical order, last assignment wins — rather than grepping our own
# file, so a later drop-in that overrides us is caught too.
_dist=$(
    set +e
    GRUB_DISTRIBUTOR=
    [ -r /etc/default/grub ] && . /etc/default/grub
    for _f in /etc/default/grub.d/*.cfg; do [ -r "$_f" ] && . "$_f"; done
    printf '%s' "$GRUB_DISTRIBUTOR"
)
[ "$_dist" = "Sysible Server" ] \
    || fail "the GRUB boot menu would read '$_dist', not 'Sysible Server' (GRUB_DISTRIBUTOR, from /etc/default/grub + grub.d)"
# The theme's own visible text (its footer tagline) ships in the same drop.
_theme=/boot/grub/themes/sysible/theme.txt
if [ -f "$_theme" ] && grep -qi 'sysible workstation' "$_theme"; then
    fail "$_theme names Sysible Workstation — this is the Server image"
fi
# ...and the repair path for machines ALREADY installed with the wrong name must
# stay alive. A correct image does nothing for a box installed from a bad one:
# the drop-in belongs to us, so no upgrade replaces it, and only the guard ever
# will. Losing that section would strand every such machine silently.
_bg=/usr/lib/sysible/branding-guard
[ -f "$_bg" ] || fail "the branding guard is missing ($_bg)"
grep -q 'GRUB_DISTRIBUTOR="Sysible Server"' "$_bg" \
    || fail "$_bg no longer re-asserts GRUB_DISTRIBUTOR — a machine already installed with the wrong product name on its boot menu would never be corrected"
grep -q 'update-grub' "$_bg" \
    || fail "$_bg no longer regenerates grub.cfg — a corrected drop-in is not a corrected boot menu"
echo "sysible-verify: OK — the boot menu reads '$_dist', and the guard keeps it that way."

# 3) Password-based SSH automation works out of the box.
# sshpass is in the metapackage's Depends, but nothing has ever asserted that
# anything in that list actually LANDED — the toolkit list is generated from it at
# build time and apt's output scrolls past. This one is worth pinning because its
# absence is invisible until the worst moment: Ansible does not degrade without
# it, it refuses ("you must install the sshpass program") on the first run against
# a host that has no key on it yet, which is the run that cannot go and fetch a
# missing package first.
command -v sshpass >/dev/null 2>&1 \
    || fail "sshpass is not in the image — Ansible cannot use a password over SSH, so bootstrapping a host that has no key yet fails at the first play"
echo "sysible-verify: OK — sshpass present (Ansible can bootstrap over a password)."

# 16b) A CONTAINER RUNTIME, and compose, are in the image.
# This is the one thing every Sysible product needs in order to run at all, and
# until now no verify step mentioned it. The chain that produced the bug report:
#
#   docker-ce is a Recommends (not a Depends) pulled from download.docker.com,
#   it is in the VEND exclusion list in build.sh so it never reaches the
#   generated toolkit list, and the vendor hook's apt-get install is the ONLY
#   thing that puts it in the image. Nothing then checked. So an ISO built while
#   that third-party repo was unreachable looked green, shipped, and the operator
#   found out at `install-sysible`.
#
# Assert the capability, not the brand: podman + podman-docker satisfies this as
# squarely as docker-ce does (the shim is /usr/bin/docker and the socket is
# symlinked), and the installer now installs either. What must never ship is an
# image with NEITHER.
command -v docker >/dev/null 2>&1 || command -v podman >/dev/null 2>&1 \
    || fail "no container runtime in the image (neither docker nor podman) — every Sysible product runs as a container, so install-sysible cannot do anything on this image"
_rt="$(command -v docker >/dev/null 2>&1 && echo docker || echo podman)"

# Compose is packaged separately from the engine on every path, so "the engine
# landed" does not mean a product can be brought up. sysiblectl looks for the v2
# plugin first and standalone docker-compose second; accept either, and
# podman-compose for a podman-only image.
_compose=none
for _c in /usr/libexec/docker/cli-plugins/docker-compose \
          /usr/lib/docker/cli-plugins/docker-compose \
          /usr/local/lib/docker/cli-plugins/docker-compose; do
    [ -x "$_c" ] && { _compose="docker compose (plugin)"; break; }
done
if [ "$_compose" = none ]; then
    if command -v docker-compose >/dev/null 2>&1; then _compose="docker-compose (standalone)"
    elif command -v podman-compose >/dev/null 2>&1; then _compose="podman-compose"
    fi
fi
[ "$_compose" != none ] \
    || fail "no compose implementation in the image (no docker compose plugin, no docker-compose, no podman-compose) — every product is brought up with compose"
echo "sysible-verify: OK — container runtime present ($_rt) with $_compose."

# 16c) install-sysible is OWNED BY A PACKAGE, so apt can replace it.
# This is the third time this project has shipped a fix that reached new images
# and skipped the installed base (guest agents, greeter branding, and the
# installer itself). install-sysible used to live only in includes.chroot: no
# package owned it, so no `apt upgrade` could ever replace it, and the machine
# that most needed an installer fix — one already installed, whose operator had
# just hit the bug — kept the broken copy for good.
#
# dpkg ownership is the thing that makes it updatable, so that is what is
# asserted, not merely that the file exists.
# ALL THREE names, because an operator types whichever one they know:
# `sysible-install` is how Sysible Server is installed, and
# `install-sysible-controller` is still in runbooks. The aliases only exec
# install-sysible, but if one of them is a stale regular file it outranks
# /usr/sbin on root's PATH and no apt update of it ever takes effect.
for _n in install-sysible sysible-install install-sysible-controller; do
    [ -x "/usr/sbin/$_n" ] \
        || fail "/usr/sbin/$_n is missing — the sysible-cli package did not install it, so apt cannot keep it current"
    _owner="$(dpkg -S "/usr/sbin/$_n" 2>/dev/null | cut -d: -f1)"
    [ -n "$_owner" ] \
        || fail "/usr/sbin/$_n is not owned by any package — it is back to being image-only, which no apt upgrade can reach"
    [ -L "/usr/local/bin/$_n" ] \
        || fail "/usr/local/bin/$_n is not a symlink — a real file there shadows the packaged copy on root's PATH and apt updates would never take effect"
    [ "$(readlink -f "/usr/local/bin/$_n")" = "/usr/sbin/$_n" ] \
        || fail "/usr/local/bin/$_n points at $(readlink -f "/usr/local/bin/$_n"), not the packaged /usr/sbin/$_n"
done
# And it offers the teardown, because "uninstall" that removes only the CLI
# symlinks is what sent operators to delete volumes by hand.
grep -q -- '--uninstall' /usr/sbin/install-sysible \
    || fail "install-sysible no longer offers --uninstall"
echo "sysible-verify: OK — install-sysible packaged in $_owner (apt can update it), /usr/local/bin link intact."

# 10) The AI model feature must stay GONE.
# `sysible ai` / `sai`, the /etc/profile.d helper and the bundled Ollama runtime
# were removed on request. This asserts the IMAGE is actually free of them, not
# just the recipe: a hook that silently stopped applying, a stale file surviving
# in includes.chroot, or a package pulling ollama back in would otherwise ship a
# feature that was deliberately taken out — and a model server enabled at boot.
for _gone in /etc/profile.d/sysible-ai.sh /usr/local/bin/ollama \
             /etc/systemd/system/ollama.service; do
    [ -e "$_gone" ] && fail "$_gone is present, but the AI model feature was removed"
done
if command -v sysible >/dev/null 2>&1; then
    sysible --help 2>&1 | grep -qiw 'ai' \
        && fail "the 'sysible' CLI still offers an 'ai' subcommand"
fi
grep -rqs 'profile.d/sysible-ai.sh' /etc/bash.bashrc \
    && fail "/etc/bash.bashrc still sources the removed AI shell helper"
id ollama >/dev/null 2>&1 && fail "the 'ollama' service account is still in the image"
# The SysTerm companion pane is part of the same feature and is built from its
# own repo during this build, so check the INSTALLED package too — a stale .deb or
# a build that picked up an older branch would put the AI pane straight back.
if [ -d /usr/lib/python3 ]; then
    find /usr/lib/python3 -path '*systerm/atlas.py' 2>/dev/null | grep -q . \
        && fail "the SysTerm Atlas companion module is still installed"
fi
[ -e /etc/profile.d/systerm-atlas.sh ] && fail "SysTerm's Atlas shell hook is still installed"
echo "sysible-verify: OK — no AI model feature in the image (no sysible ai, no sai, no ollama)."

# ---------------------------------------------------------------------------
# The tools the product pages promise are actually IN the image.
#
# WHY THIS EXISTS, and why it is not a metapackage Depends. Three of these are
# not apt packages at all: helm and opentofu are installed from their vendors'
# official binaries (their apt repos misbehave in a fresh chroot -- baltocdn.com
# serves an incomplete TLS chain, packages.opentofu.org needs a second signing
# key) and k9s comes from a GitHub release. `Depends: helm` would fail the build
# with "no installation candidate", and the Recommends they sat in was satisfied
# by nothing at all -- apt skips an unsatisfiable Recommends in silence. So the
# image advertised four tools whose presence rested entirely on a hook that was
# allowed to skip them.
#
# This is a STRONGER guarantee than a Depends, not a weaker substitute. A
# Depends is satisfied when dpkg marks a package installed. This asserts the
# program is actually on PATH in the finished image, and the build dies if it
# is not.
echo "== sysible-verify: tools the product pages promise =="
# ADDED: the cloud and virtualization tools, and the headline Debian ones.
#
# az and gcloud rest ENTIRELY on the vendor hook (both are in build.sh's VEND
# set, so neither reaches the generated toolkit list) -- exactly the position
# helm, k9s and sops were in when an ISO shipped without them. age and gh do
# come from the toolkit list, but nothing asserted either had landed.
#
# virsh and qemu-img are the libvirt/QEMU capability. The summary below this
# loop has claimed for some time that libvirt/QEMU is "installed above and
# checked by name"; it was not checked by anything. It is now.
#
# yq, socat, git-lfs, shellcheck, rclone and wg are newly promised in the
# metapackage. They are hard entries in the generated list, so apt would fail
# the build if they vanished from Debian -- but NOT if someone edits them out
# of debian/control, which is the likelier way a promise gets broken.
for _t in docker kubectl helm k9s tofu ansible ansible-playbook podman \
          git curl openssl nft jq \
          sops eza pwsh \
          az gcloud virsh qemu-img age gh \
          yq socat git-lfs shellcheck rclone wg; do
    command -v "$_t" >/dev/null 2>&1 \
        || fail "$_t is NOT in the image, but the product pages list it as included"
done

# Compose is checked by package and by plugin path rather than by running it:
# the daemon is not up inside a build chroot, so `docker compose version` is not
# a safe probe here.
dpkg-query -W -f='${Status}' docker-compose-plugin 2>/dev/null \
    | grep -q 'install ok installed' \
    || fail "docker-compose-plugin is not installed — every Sysible app is brought up with 'docker compose'"
_dc=""
for _p in /usr/libexec/docker/cli-plugins/docker-compose \
          /usr/lib/docker/cli-plugins/docker-compose \
          /usr/local/lib/docker/cli-plugins/docker-compose; do
    [ -x "$_p" ] && _dc="$_p" && break
done
[ -n "$_dc" ] || fail "the docker compose plugin binary is not where the CLI looks for it"

# SLOP's installer needs these on the HOST before it can bring the gateway up:
# git to clone the products, docker + compose to run them, openssl to mint the
# SSO/updater/Baseline/Flashback secrets. `install-sysible slop` is one of the
# two questions the installer asks, so a host that cannot run it is a broken
# promise made during the install itself.
# THE ISO CARRIES THE DEPENDENCIES, NOT THE PLATFORM.
#
# Everything the platform needs to run is installed above and checked by name:
# Docker and the compose plugin, Ansible, podman, libvirt/QEMU, kubectl, helm,
# k9s, tofu, git, curl, openssl, nftables, jq, sops, eza and PowerShell. That is
# the ISO's job — an operator should never be installing a container runtime by
# hand before the software they were sold will start.
#
# The PLATFORM is not the ISO's job, and both of the ways it used to be baked in
# are now asserted ABSENT here:
#
#   the SOURCE  carried actions/checkout's Authorization header — that action's
#               cleanup runs after live-build has already squashed the tree, so
#               v1.0.10 shipped a live GitHub token in every ISO. What operators
#               met was not a warning but
#                   Username for 'https://github.com':
#               on every `sysiblectl update`, against a PUBLIC repository.
#   the IMAGES  went stale the same way, just more expensively: every app change
#               made every existing ISO wrong, and shipping a one-line app fix
#               to a fresh install meant a forty-minute ISO rebuild.
#
# install-sysible fetches the platform from GitHub, which is what it does on any
# other machine. A first boot needs a network for that — it needed one for the
# source anyway.
PIMG=/usr/share/sysible/app-images
PSRC=/opt/sysible-src
[ ! -e "$PIMG" ] || fail "$PIMG exists — container images are being baked into the image again. The ISO ships the dependencies; install-sysible fetches the platform."
[ ! -e "$PSRC" ] || fail "$PSRC exists — a source checkout is being baked into the image again, which is how a live GitHub token shipped in v1.0.10"
echo "sysible-verify: OK — dependencies present, no platform payload (install-sysible fetches it)."

echo "sysible-verify: OK — kubectl, helm, k9s, tofu, compose and the SLOP prerequisites are all present."

echo "sysible-verify: OK — headless image verified."
