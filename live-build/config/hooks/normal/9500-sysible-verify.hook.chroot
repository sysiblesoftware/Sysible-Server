#!/bin/sh
# Build-time guarantee. Runs after packages are installed and FAILS the whole ISO
# build if the headless image didn't come out right: the target bootloader must be
# installable, and the Sysible boot-menu branding must match the canonical mark.
set -e

fail() { echo "SYSIBLE-VERIFY FATAL: $1" >&2; exit 1; }

# 1) The target bootloader is installable offline. grub must be INSTALLED in the
# live chroot so its .deb is in the ISO pool and already present in the unpacked
# target; otherwise the Debian Installer cannot make the installed system bootable
# on a machine with no network. Assert both the arch grub-efi package and
# update-grub are actually here.
ARCH=$(dpkg --print-architecture 2>/dev/null || echo unknown)
case "$ARCH" in
    arm64) GRUB_PKG=grub-efi-arm64 ;;
    amd64) GRUB_PKG=grub-efi-amd64 ;;
    *)     GRUB_PKG=grub-efi-amd64 ;;
esac
dpkg-query -W -f='${Status}' "$GRUB_PKG" 2>/dev/null | grep -q 'install ok installed' \
    || fail "$GRUB_PKG not installed — the installer cannot make the target bootable offline"
[ -x /usr/sbin/update-grub ] || fail "/usr/sbin/update-grub missing — grub-common not installed"
echo "sysible-verify: OK — $GRUB_PKG installed, update-grub present (target install can bootload)."

# 2) Boot-menu branding integrity. The Sysible GRUB boot-menu logo/background are
# rendered from ONE canonical mark (branding/logo/sysible-mark.svg) and their
# sha256 recorded in a manifest shipped into the image. Assert the on-disk files
# still match — this is what stops the GRUB boot logo from silently drifting back
# to old art. Env-independent: just sha256 of the committed bytes.
BMAN=/usr/share/sysible/branding.manifest
[ -f "$BMAN" ] || fail "branding manifest missing ($BMAN)"
PREFIX=live-build/config/includes.chroot
checked=0
while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    sha=${line%% *}
    rel=${line#* }
    rel=${rel# }
    # Only the assets that actually land in the installed root (under
    # includes.chroot); ISO-only splashes and repo README badges are skipped here
    # and covered by scripts/verify-branding.sh in CI instead.
    case "$rel" in
        "$PREFIX"/*) img="/${rel#"$PREFIX"/}" ;;
        *) continue ;;
    esac
    [ -f "$img" ] || fail "branded asset missing from image: $img"
    act=$(sha256sum "$img" 2>/dev/null | awk '{print $1}')
    [ "$act" = "$sha" ] || fail "branded asset drifted from the canonical mark: $img"
    checked=$((checked + 1))
done < "$BMAN"
[ "$checked" -gt 0 ] || fail "branding manifest matched no in-image assets"
echo "sysible-verify: OK — $checked branded assets match the canonical mark (incl. GRUB boot logo)."

# 2b) Boot-menu WORDING. Section 2 proves the boot menu's ARTWORK is ours; nothing
# proved its TEXT was. Every entry in the GRUB menu is literally
# GRUB_DISTRIBUTOR, and the only thing that has ever got that wrong was us: this
# repo was rebranded to "Sysible Workstation" (b0715be) and back a day later
# (8a2f18e), and the images built in between shipped a boot menu naming the wrong
# product. The build did not notice, because nothing looked.
#
# Compute the value the way grub-mkconfig does — /etc/default/grub first, then the
# drop-ins in lexical order, last assignment wins — rather than grepping our own
# file, so a later drop-in that overrides us is caught too.
_dist=$(
    set +e
    GRUB_DISTRIBUTOR=
    [ -r /etc/default/grub ] && . /etc/default/grub
    for _f in /etc/default/grub.d/*.cfg; do [ -r "$_f" ] && . "$_f"; done
    printf '%s' "$GRUB_DISTRIBUTOR"
)
[ "$_dist" = "Sysible Server" ] \
    || fail "the GRUB boot menu would read '$_dist', not 'Sysible Server' (GRUB_DISTRIBUTOR, from /etc/default/grub + grub.d)"
# The theme's own visible text (its footer tagline) ships in the same drop.
_theme=/boot/grub/themes/sysible/theme.txt
if [ -f "$_theme" ] && grep -qi 'sysible workstation' "$_theme"; then
    fail "$_theme names Sysible Workstation — this is the Server image"
fi
# ...and the repair path for machines ALREADY installed with the wrong name must
# stay alive. A correct image does nothing for a box installed from a bad one:
# the drop-in belongs to us, so no upgrade replaces it, and only the guard ever
# will. Losing that section would strand every such machine silently.
_bg=/usr/lib/sysible/branding-guard
[ -f "$_bg" ] || fail "the branding guard is missing ($_bg)"
grep -q 'GRUB_DISTRIBUTOR="Sysible Server"' "$_bg" \
    || fail "$_bg no longer re-asserts GRUB_DISTRIBUTOR — a machine already installed with the wrong product name on its boot menu would never be corrected"
grep -q 'update-grub' "$_bg" \
    || fail "$_bg no longer regenerates grub.cfg — a corrected drop-in is not a corrected boot menu"
echo "sysible-verify: OK — the boot menu reads '$_dist', and the guard keeps it that way."

# 3) Password-based SSH automation works out of the box.
# sshpass is in the metapackage's Depends, but nothing has ever asserted that
# anything in that list actually LANDED — the toolkit list is generated from it at
# build time and apt's output scrolls past. This one is worth pinning because its
# absence is invisible until the worst moment: Ansible does not degrade without
# it, it refuses ("you must install the sshpass program") on the first run against
# a host that has no key on it yet, which is the run that cannot go and fetch a
# missing package first.
command -v sshpass >/dev/null 2>&1 \
    || fail "sshpass is not in the image — Ansible cannot use a password over SSH, so bootstrapping a host that has no key yet fails at the first play"
echo "sysible-verify: OK — sshpass present (Ansible can bootstrap over a password)."

# 10) The AI model feature must stay GONE.
# `sysible ai` / `sai`, the /etc/profile.d helper and the bundled Ollama runtime
# were removed on request. This asserts the IMAGE is actually free of them, not
# just the recipe: a hook that silently stopped applying, a stale file surviving
# in includes.chroot, or a package pulling ollama back in would otherwise ship a
# feature that was deliberately taken out — and a model server enabled at boot.
for _gone in /etc/profile.d/sysible-ai.sh /usr/local/bin/ollama \
             /etc/systemd/system/ollama.service; do
    [ -e "$_gone" ] && fail "$_gone is present, but the AI model feature was removed"
done
if command -v sysible >/dev/null 2>&1; then
    sysible --help 2>&1 | grep -qiw 'ai' \
        && fail "the 'sysible' CLI still offers an 'ai' subcommand"
fi
grep -rqs 'profile.d/sysible-ai.sh' /etc/bash.bashrc \
    && fail "/etc/bash.bashrc still sources the removed AI shell helper"
id ollama >/dev/null 2>&1 && fail "the 'ollama' service account is still in the image"
# The SysTerm companion pane is part of the same feature and is built from its
# own repo during this build, so check the INSTALLED package too — a stale .deb or
# a build that picked up an older branch would put the AI pane straight back.
if [ -d /usr/lib/python3 ]; then
    find /usr/lib/python3 -path '*systerm/atlas.py' 2>/dev/null | grep -q . \
        && fail "the SysTerm Atlas companion module is still installed"
fi
[ -e /etc/profile.d/systerm-atlas.sh ] && fail "SysTerm's Atlas shell hook is still installed"
echo "sysible-verify: OK — no AI model feature in the image (no sysible ai, no sai, no ollama)."

echo "sysible-verify: OK — headless image verified."
