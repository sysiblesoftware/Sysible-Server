#!/bin/sh
# Rebuild the initramfs so the virtual-GPU DRM/KMS modules listed in
# /etc/initramfs-tools/modules (shipped via includes.chroot) are baked into
# /boot/initrd.img. This is what makes the framebuffer console light up early on
# the installed system's VM display (the "black screen after GRUB" fix). The
# installed target inherits this initrd (and regenerates from the same modules
# file), so early KMS is present there too. Non-fatal: log and continue.
set -e
echo "sysible-initramfs: forcing early-KMS DRM modules into the initramfs..."
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u 2>&1 | sed 's/^/  /' || echo "sysible-initramfs: update-initramfs returned nonzero (continuing)" >&2
    echo "sysible-initramfs: DRM modules now present in initrd:"
    for m in vmwgfx virtio_gpu bochs bochs-drm qxl; do
        if lsinitramfs /boot/initrd.img* 2>/dev/null | grep -qiE "/${m}\.ko"; then
            echo "  [x] $m"
        else
            echo "  [ ] $m (not found — device may be absent for this arch/kernel)"
        fi
    done
else
    echo "sysible-initramfs: update-initramfs not available — skipping." >&2
fi
exit 0
