#!/bin/sh
# Prepare the Debian Installer: inject the preseed, apply Sysible branding, and
# guarantee the paths the boot menu references actually exist.
#
# Runs as a BINARY hook, i.e. during the binary stage BEFORE binary_iso builds
# the ISO and BEFORE binary_checksums runs. That ordering matters: editing the
# finished ISO instead breaks the /install directory layout (it produced
# "file /install/gtk/vmlinuz not found"), and doing it here means checksums are
# computed over the already-patched files.
#
# THREE JOBS, in order:
#
# 1. PRESEED into every installer initrd. d-i automatically loads /preseed.cfg
#    from the root of its own initrd — no kernel argument, nothing to lose. This
#    is what carries the bootloader fixes (EFI removable path + BIOS
#    grub-install), so if it is missing the installed system has nothing to boot.
#
#    Installer initrds are found BY PATH (anything named initrd*.gz under an
#    install*/ directory). The previous content probe looked for the graphical
#    banner instead, which silently matched NOTHING on arm64 — that image ships
#    only a TEXT installer with no graphics — so arm64 got no preseed at all and
#    every bootloader fix was absent from it.
#
# 2. BRANDING, only for initrds that actually contain the graphical installer
#    (banner PNGs / gtkrc). A text-mode installer has neither; skipping it there
#    is correct, not a failure.
#
# 3. GTK FALLBACK. The generated menu offers a "Graphical install" entry pointing
#    at install/gtk/{vmlinuz,initrd.gz}. On arm64 that directory does not exist
#    at all, so the entry dies with "file not found ... you need to load the
#    kernel first". Rather than rewrite menu files (whose location varies), make
#    the referenced paths real by copying the text installer's kernel/initrd into
#    install/gtk/. Any entry that points there then boots the installer that
#    exists. Where a real graphical installer IS shipped (amd64) nothing is
#    overwritten.
#
# Best-effort throughout: never fail the build, and log what happened.
set -e

BANNER="${SYSIBLE_INSTALLER_BANNER:-}"
PRESEED="${SYSIBLE_PRESEED:-}"
ASK_TOOLS="${SYSIBLE_ASK_TOOLS:-}"
ASK_TEMPLATES="${SYSIBLE_ASK_TEMPLATES:-}"
ASK_HOOK="${SYSIBLE_ASK_HOOK:-}"
command -v cpio >/dev/null 2>&1 || { echo "sysible-installer: cpio unavailable — skipping." >&2; exit 0; }

SYSIBLE_GTKRC='
# --- Sysible Server brand palette (appended last, highest priority) --------
style "sysible-brand" {
    bg[NORMAL]        = "#0f1620"
    bg[PRELIGHT]      = "#1f9d55"
    bg[SELECTED]      = "#3f6fb5"
    bg[ACTIVE]        = "#16324a"
    bg[INSENSITIVE]   = "#0f1620"

    fg[NORMAL]        = "#e9f0f7"
    fg[PRELIGHT]      = "#08130c"
    fg[SELECTED]      = "#ffffff"
    fg[ACTIVE]        = "#e9f0f7"
    fg[INSENSITIVE]   = "#6b7a8a"

    base[NORMAL]      = "#0b1016"
    base[PRELIGHT]    = "#0b1016"
    base[SELECTED]    = "#3f6fb5"
    base[ACTIVE]      = "#16324a"
    base[INSENSITIVE] = "#0b1016"

    text[NORMAL]      = "#e9f0f7"
    text[PRELIGHT]    = "#e9f0f7"
    text[SELECTED]    = "#ffffff"
    text[ACTIVE]      = "#e9f0f7"
    text[INSENSITIVE] = "#6b7a8a"
}
class  "*" style : highest "sysible-brand"
widget "*" style : highest "sysible-brand"

style "sysible-progress" = "sysible-brand" {
    bg[PRELIGHT]   = "#1f9d55"
    fg[PRELIGHT]   = "#08130c"
    base[PRELIGHT] = "#1f9d55"
}
widget_class "*GtkProgress*" style : highest "sysible-progress"
class        "*GtkProgress*" style : highest "sysible-progress"
'

# The TEXT installer's palette. Everything above this point only ever reached
# the GRAPHICAL installer: the banner swap needs usr/share/graphics and the
# gtkrc append needs a gtkrc, and a text-mode initrd has neither. So d-i's newt
# frontend stayed stock Debian — blue background, grey dialogs, red highlights.
#
# That is not a corner case. This hook's own notes record that arm64 ships NO
# graphical installer at all, so on arm64 the unbranded text installer is the
# ONLY installer anyone ever sees.
#
# libnewt reads NEWT_COLORS from the environment, and /sbin/debian-installer
# sources every /lib/debian-installer-startup.d/* script before starting the
# frontend — so a script dropped there sets the palette for the whole install.
# The colours are the same ones sysible-tools already uses on the installed
# system, so the installer and the system it installs look like one product.
SYSIBLE_NEWT_COLORS='root=,black
window=,black
border=green,black
title=green,black
button=black,green
compactbutton=green,black
actbutton=black,green
checkbox=white,black
actcheckbox=black,green
entry=white,black
label=green,black
listbox=white,black
actlistbox=black,green
sellistbox=black,green
textbox=white,black
acttextbox=black,green
roottext=green,black
emptyscale=,black
fullscale=,green
helpline=green,black'

echo "sysible-installer: preseed='${PRESEED:-<unset>}' ask-tools='${ASK_TOOLS:-<unset>}' banner='${BANNER:-<unset>}'"
echo "sysible-installer: installer trees found:"
find . -maxdepth 3 -type d -name 'install*' 2>/dev/null | sed 's/^/    /' || true

patched=0; preseeded=0; branded=0; paletted=0; worded=0; hooked=0
# BY PATH, not by content — a text-mode installer initrd carries no graphics.
for initrd in $(find . -type f -path '*install*' -name 'initrd*.gz' 2>/dev/null); do
    gzip -t "$initrd" 2>/dev/null || continue
    work=$(mktemp -d)
    gzip -dc "$initrd" 2>/dev/null | ( cd "$work" && cpio -idm --quiet 2>/dev/null ) || { rm -rf "$work"; continue; }

    did_preseed=no; did_brand=no; did_palette=no; did_ask=no; did_words=no; did_hook=no

    # 1) preseed at the initrd root — auto-loaded by d-i, no boot argument.
    if [ -n "$PRESEED" ] && [ -f "$PRESEED" ]; then
        cp -f "$PRESEED" "$work/preseed.cfg" && chmod 0644 "$work/preseed.cfg"
        did_preseed=yes; preseeded=$((preseeded + 1))
    fi

    # 1b) and what that preseed's early_command actually RUNS. It fires before
    #     cdrom-detect has mounted anything, so a script left only on the ISO
    #     root is unreachable at exactly the moment it is called -- and the
    #     deliberate `|| true` there means the miss is invisible. Put both in
    #     the initrd beside the preseed, where it can always open them.
    if [ -n "$ASK_TOOLS" ] && [ -f "$ASK_TOOLS" ]; then
        cp -f "$ASK_TOOLS" "$work/sysible-ask-tools" && chmod 0755 "$work/sysible-ask-tools"
        did_ask=yes
    fi
    # 1b-ii) and WHEN it runs. The asker used to be fired by preseed/early_command,
    #        which is S33 of the STARTUP chain -- before S60frontend picks a
    #        frontend and before S62Xorg starts X for it. cdebconf therefore fell
    #        back to its compiled-in default (/etc/cdebconf.conf, driver "newt")
    #        and drew the question in stock-blue newt on every boot entry, BIOS and
    #        UEFI alike. Dropping this file into /lib/debian-installer.d/ runs it at
    #        S66 of the MAIN chain instead: after the frontend exists and after X is
    #        up for it, before S70menu. gtk in the graphical installer, newt only on
    #        a real text/serial install.
    if [ -n "$ASK_HOOK" ] && [ -f "$ASK_HOOK" ]; then
        mkdir -p "$work/lib/debian-installer.d" \
            && cp -f "$ASK_HOOK" "$work/lib/debian-installer.d/S66sysible-ask" \
            && chmod 0755 "$work/lib/debian-installer.d/S66sysible-ask" \
            && { did_hook=yes; hooked=$((hooked + 1)); }
    fi
    if [ -n "$ASK_TEMPLATES" ] && [ -f "$ASK_TEMPLATES" ]; then
        cp -f "$ASK_TEMPLATES" "$work/sysible-tools.templates" \
            && chmod 0644 "$work/sysible-tools.templates"
    fi

    # 1c) The installer's OWN WORDS. d-i reads its visible text from the
    #     debconf template databases carried in this initrd -- menu entries,
    #     step titles, prompts, the finish screen. Untouched, a Sysible install
    #     calls itself Debian throughout: "Debian installer main menu", "Install
    #     the GRUB boot loader", "Finish the installation ... Debian GNU/Linux".
    #
    #     ONLY the capitalised, standalone word, and only on lines that carry no
    #     URL and no path. Every load-bearing use is lowercase and is an
    #     IDENTIFIER, not prose:
    #
    #       deb.debian.org / security.debian.org   apt sources
    #       /EFI/debian, --bootloader-id=debian    where grub-installer writes
    #       debian-installer, debconf, .deb        binaries and package names
    #
    #     Rewriting any of those breaks apt, UEFI boot, or the installer itself,
    #     which is why this is a word-boundary match on the capital form and
    #     skips anything that looks like an address or a path.
    for _db in var/lib/cdebconf/templates.dat var/lib/cdebconf/questions.dat \
               var/cache/debconf/templates.dat usr/share/debconf/templates.dat; do
        [ -f "$work/$_db" ] || continue
        sed -i -e '/http:\/\//b' -e '/https:\/\//b' -e '/\/EFI\//b' \
               -e '/debian\.org/b' -e '/bootloader-id/b' \
               -e 's/\bDebian GNU\/Linux\b/Sysible/g' \
               -e 's/\bDebian\b/Sysible/g' "$work/$_db" 2>/dev/null \
            && { did_words=yes; }
    done
    [ "$did_words" = yes ] && worded=$((worded + 1))

    # 2) branding — only meaningful for the graphical installer.
    if [ -n "$BANNER" ] && [ -f "$BANNER" ] && [ -d "$work/usr/share/graphics" ]; then
        for g in logo_installer.png logo_debian.png; do
            [ -e "$work/usr/share/graphics/$g" ] && cp -f "$BANNER" "$work/usr/share/graphics/$g" && did_brand=yes
        done
    fi
    for rc in $(cd "$work" && find . -type f -name 'gtkrc' 2>/dev/null); do
        printf '%s\n' "$SYSIBLE_GTKRC" >> "$work/${rc#./}"; did_brand=yes
    done
    [ "$did_brand" = yes ] && branded=$((branded + 1))

    # 2b) Palette for the TEXT frontend. Applies to EVERY installer initrd,
    #     including the ones with no graphics at all — those are the stock-blue
    #     ones. Written two ways because only one of them needs to work:
    #     a startup.d script (sourced by /sbin/debian-installer before the
    #     frontend starts) and /etc/newt/palette with NEWT_COLORS_FILE.
    mkdir -p "$work/lib/debian-installer-startup.d" "$work/etc/newt" 2>/dev/null || true
    if [ -d "$work/lib/debian-installer-startup.d" ]; then
        printf '%s\n' "$SYSIBLE_NEWT_COLORS" > "$work/etc/newt/palette" 2>/dev/null || true
        {
            echo '#!/bin/sh'
            echo '# Sysible: brand the text installer. Sourced by /sbin/debian-installer.'
            echo "NEWT_COLORS='$SYSIBLE_NEWT_COLORS'"
            echo 'export NEWT_COLORS'
            echo 'NEWT_COLORS_FILE=/etc/newt/palette'
            echo 'export NEWT_COLORS_FILE'
        } > "$work/lib/debian-installer-startup.d/S99sysible-palette" 2>/dev/null \
            && chmod 0755 "$work/lib/debian-installer-startup.d/S99sysible-palette" 2>/dev/null \
            && { did_palette=yes; paletted=$((paletted + 1)); }
    fi

    ( cd "$work" && find . | cpio -o -H newc --quiet 2>/dev/null | gzip -9 ) > "$initrd.new" \
        && mv -f "$initrd.new" "$initrd"
    rm -rf "$work"
    echo "sysible-installer: patched $initrd (preseed=$did_preseed ask-tools=$did_ask ask-hook=$did_hook branding=$did_brand palette=$did_palette words=$did_words)"
    patched=$((patched + 1))
done
echo "sysible-installer: $patched installer initrd(s): $preseeded preseeded, $branded branded, $paletted palette(s), $worded reworded, $hooked ask-hook(s)."
[ "$paletted" = 0 ] && echo "sysible-installer: WARNING — no initrd got the text palette; the installer will look like stock Debian." >&2
[ "$preseeded" = 0 ] && echo "sysible-installer: WARNING — NO initrd received the preseed; the installed system may have no bootloader." >&2
# An initrd with the asker but no S66 hook asks NOTHING: early_command no longer
# calls it, and nothing else does. That is silent, so say it loudly here.
[ "$hooked" = 0 ] && echo "sysible-installer: WARNING — no initrd got S66sysible-ask; the optional-software question will NOT be asked." >&2

# 3) Make install/gtk/* real wherever the menu may point at it.
for d in $(find . -maxdepth 3 -type d -name 'install*' 2>/dev/null); do
    [ -f "$d/vmlinuz" ] || continue
    mkdir -p "$d/gtk" 2>/dev/null || continue
    if [ ! -f "$d/gtk/vmlinuz" ]; then
        cp -f "$d/vmlinuz" "$d/gtk/vmlinuz" && echo "sysible-installer: created $d/gtk/vmlinuz (shared kernel — the graphical entry needs this path)"
    fi
    if [ ! -f "$d/gtk/initrd.gz" ] && [ -f "$d/initrd.gz" ]; then
        cp -f "$d/initrd.gz" "$d/gtk/initrd.gz" && echo "sysible-installer: created $d/gtk/initrd.gz (falls back to the text installer)"
    fi
done
echo "sysible-installer: final installer payload:"
find . -type f -path '*install*' \( -name 'vmlinuz*' -o -name 'initrd*.gz' \) -exec ls -la {} \; 2>/dev/null | sed 's/^/    /'
exit 0
