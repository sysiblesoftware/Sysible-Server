#!/bin/sh
# Prepare the Debian Installer: inject the preseed, apply Sysible branding, and
# guarantee the paths the boot menu references actually exist.
#
# Runs as a BINARY hook, i.e. during the binary stage BEFORE binary_iso builds
# the ISO and BEFORE binary_checksums runs. That ordering matters: editing the
# finished ISO instead breaks the /install directory layout (it produced
# "file /install/gtk/vmlinuz not found"), and doing it here means checksums are
# computed over the already-patched files.
#
# THREE JOBS, in order:
#
# 1. PRESEED into every installer initrd. d-i automatically loads /preseed.cfg
#    from the root of its own initrd — no kernel argument, nothing to lose. This
#    is what carries the bootloader fixes (EFI removable path + BIOS
#    grub-install), so if it is missing the installed system has nothing to boot.
#
#    Installer initrds are found BY PATH (anything named initrd*.gz under an
#    install*/ directory). The previous content probe looked for the graphical
#    banner instead, which silently matched NOTHING on arm64 — that image ships
#    only a TEXT installer with no graphics — so arm64 got no preseed at all and
#    every bootloader fix was absent from it.
#
# 2. BRANDING, only for initrds that actually contain the graphical installer
#    (banner PNGs / gtkrc). A text-mode installer has neither; skipping it there
#    is correct, not a failure.
#
# 3. GTK FALLBACK. The generated menu offers a "Graphical install" entry pointing
#    at install/gtk/{vmlinuz,initrd.gz}. On arm64 that directory does not exist
#    at all, so the entry dies with "file not found ... you need to load the
#    kernel first". Rather than rewrite menu files (whose location varies), make
#    the referenced paths real by copying the text installer's kernel/initrd into
#    install/gtk/. Any entry that points there then boots the installer that
#    exists. Where a real graphical installer IS shipped (amd64) nothing is
#    overwritten.
#
# Best-effort throughout: never fail the build, and log what happened.
set -e

BANNER="${SYSIBLE_INSTALLER_BANNER:-}"
PRESEED="${SYSIBLE_PRESEED:-}"
command -v cpio >/dev/null 2>&1 || { echo "sysible-installer: cpio unavailable — skipping." >&2; exit 0; }

SYSIBLE_GTKRC='
# --- Sysible Server brand palette (appended last, highest priority) --------
style "sysible-brand" {
    bg[NORMAL]        = "#0f1620"
    bg[PRELIGHT]      = "#1f9d55"
    bg[SELECTED]      = "#3f6fb5"
    bg[ACTIVE]        = "#16324a"
    bg[INSENSITIVE]   = "#0f1620"

    fg[NORMAL]        = "#e9f0f7"
    fg[PRELIGHT]      = "#08130c"
    fg[SELECTED]      = "#ffffff"
    fg[ACTIVE]        = "#e9f0f7"
    fg[INSENSITIVE]   = "#6b7a8a"

    base[NORMAL]      = "#0b1016"
    base[PRELIGHT]    = "#0b1016"
    base[SELECTED]    = "#3f6fb5"
    base[ACTIVE]      = "#16324a"
    base[INSENSITIVE] = "#0b1016"

    text[NORMAL]      = "#e9f0f7"
    text[PRELIGHT]    = "#e9f0f7"
    text[SELECTED]    = "#ffffff"
    text[ACTIVE]      = "#e9f0f7"
    text[INSENSITIVE] = "#6b7a8a"
}
class  "*" style : highest "sysible-brand"
widget "*" style : highest "sysible-brand"

style "sysible-progress" = "sysible-brand" {
    bg[PRELIGHT]   = "#1f9d55"
    fg[PRELIGHT]   = "#08130c"
    base[PRELIGHT] = "#1f9d55"
}
widget_class "*GtkProgress*" style : highest "sysible-progress"
class        "*GtkProgress*" style : highest "sysible-progress"
'

echo "sysible-installer: preseed='${PRESEED:-<unset>}' banner='${BANNER:-<unset>}'"
echo "sysible-installer: installer trees found:"
find . -maxdepth 3 -type d -name 'install*' 2>/dev/null | sed 's/^/    /' || true

patched=0; preseeded=0; branded=0
# BY PATH, not by content — a text-mode installer initrd carries no graphics.
for initrd in $(find . -type f -path '*install*' -name 'initrd*.gz' 2>/dev/null); do
    gzip -t "$initrd" 2>/dev/null || continue
    work=$(mktemp -d)
    gzip -dc "$initrd" 2>/dev/null | ( cd "$work" && cpio -idm --quiet 2>/dev/null ) || { rm -rf "$work"; continue; }

    did_preseed=no; did_brand=no

    # 1) preseed at the initrd root — auto-loaded by d-i, no boot argument.
    if [ -n "$PRESEED" ] && [ -f "$PRESEED" ]; then
        cp -f "$PRESEED" "$work/preseed.cfg" && chmod 0644 "$work/preseed.cfg"
        did_preseed=yes; preseeded=$((preseeded + 1))
    fi

    # 2) branding — only meaningful for the graphical installer.
    if [ -n "$BANNER" ] && [ -f "$BANNER" ] && [ -d "$work/usr/share/graphics" ]; then
        for g in logo_installer.png logo_debian.png; do
            [ -e "$work/usr/share/graphics/$g" ] && cp -f "$BANNER" "$work/usr/share/graphics/$g" && did_brand=yes
        done
    fi
    for rc in $(cd "$work" && find . -type f -name 'gtkrc' 2>/dev/null); do
        printf '%s\n' "$SYSIBLE_GTKRC" >> "$work/${rc#./}"; did_brand=yes
    done
    [ "$did_brand" = yes ] && branded=$((branded + 1))

    ( cd "$work" && find . | cpio -o -H newc --quiet 2>/dev/null | gzip -9 ) > "$initrd.new" \
        && mv -f "$initrd.new" "$initrd"
    rm -rf "$work"
    echo "sysible-installer: patched $initrd (preseed=$did_preseed branding=$did_brand)"
    patched=$((patched + 1))
done
echo "sysible-installer: $patched installer initrd(s): $preseeded preseeded, $branded branded."
[ "$preseeded" = 0 ] && echo "sysible-installer: WARNING — NO initrd received the preseed; the installed system may have no bootloader." >&2

# 3) Make install/gtk/* real wherever the menu may point at it.
for d in $(find . -maxdepth 3 -type d -name 'install*' 2>/dev/null); do
    [ -f "$d/vmlinuz" ] || continue
    mkdir -p "$d/gtk" 2>/dev/null || continue
    if [ ! -f "$d/gtk/vmlinuz" ]; then
        cp -f "$d/vmlinuz" "$d/gtk/vmlinuz" && echo "sysible-installer: created $d/gtk/vmlinuz (shared kernel — the graphical entry needs this path)"
    fi
    if [ ! -f "$d/gtk/initrd.gz" ] && [ -f "$d/initrd.gz" ]; then
        cp -f "$d/initrd.gz" "$d/gtk/initrd.gz" && echo "sysible-installer: created $d/gtk/initrd.gz (falls back to the text installer)"
    fi
done
echo "sysible-installer: final installer payload:"
find . -type f -path '*install*' \( -name 'vmlinuz*' -o -name 'initrd*.gz' \) -exec ls -la {} \; 2>/dev/null | sed 's/^/    /'
exit 0
