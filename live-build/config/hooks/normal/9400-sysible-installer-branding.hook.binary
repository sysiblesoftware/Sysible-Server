#!/bin/sh
# Sysible-brand the Debian graphical installer.
#
# The graphical installer's banner ("debian 12") is /usr/share/graphics/
# logo_installer.png (and logo_debian.png), baked into the g-i initrd. There is no
# clean live-build override for it, so we repack every installer initrd that
# carries those graphics, swapping in the Sysible banner. Runs as a BINARY hook,
# so it operates on the assembled binary/ tree (CWD = the live-build root), after
# the debian-installer stage has placed the initrds.
#
# Best-effort: it never aborts the build (a stock-branded installer still works),
# but it logs loudly what it patched — or that it found nothing — so a path change
# in a future Debian is diagnosable from the build log.
set -e

SRC="config/installer-branding"
BANNER="$SRC/logo_installer.png"
if [ ! -f "$BANNER" ]; then
    echo "sysible-installer-branding: $BANNER missing — skipping." >&2
    exit 0
fi
command -v cpio >/dev/null 2>&1 || { echo "sysible-installer-branding: cpio unavailable — skipping." >&2; exit 0; }

patched=0
found=0
# Every installer initrd in the binary tree (graphical d-i lives under .../gtk/).
for initrd in $(find binary -type f \( -name 'initrd.gz' -o -name 'initrd' -o -name 'initrd.img' \) 2>/dev/null); do
    found=$((found + 1))
    work=$(mktemp -d)
    # Decompress (gzip or raw cpio) into a work tree.
    if gzip -t "$initrd" 2>/dev/null; then
        gzip -dc "$initrd" 2>/dev/null | ( cd "$work" && cpio -idm --quiet 2>/dev/null ) || { rm -rf "$work"; continue; }
        comp="gzip"
    else
        ( cd "$work" && cpio -idm --quiet 2>/dev/null ) < "$initrd" || { rm -rf "$work"; continue; }
        comp="raw"
    fi
    # Only touch initrds that actually carry the installer graphics.
    if [ ! -e "$work/usr/share/graphics/logo_installer.png" ] && [ ! -e "$work/usr/share/graphics/logo_debian.png" ]; then
        rm -rf "$work"; continue
    fi
    for g in logo_installer.png logo_debian.png; do
        if [ -e "$work/usr/share/graphics/$g" ] && [ -f "$SRC/$g" ]; then
            cp -f "$SRC/$g" "$work/usr/share/graphics/$g"
        fi
    done
    # Repack in the same format, preserving the newc cpio format d-i expects.
    if [ "$comp" = "gzip" ]; then
        ( cd "$work" && find . | cpio -o -H newc --quiet 2>/dev/null | gzip -9 ) > "$initrd.new" && mv -f "$initrd.new" "$initrd"
    else
        ( cd "$work" && find . | cpio -o -H newc --quiet 2>/dev/null ) > "$initrd.new" && mv -f "$initrd.new" "$initrd"
    fi
    rm -rf "$work"
    patched=$((patched + 1))
    echo "sysible-installer-branding: rebranded $initrd" >&2
done

echo "sysible-installer-branding: scanned $found initrd(s), rebranded $patched." >&2
if [ "$patched" = 0 ]; then
    echo "sysible-installer-branding: WARNING — no installer initrd carried the banner graphics; the installer will keep Debian branding. Check the initrd path for this Debian release." >&2
fi
exit 0
