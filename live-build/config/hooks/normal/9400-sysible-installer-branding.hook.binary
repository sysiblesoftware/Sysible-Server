#!/bin/sh
# Sysible-brand the Debian graphical installer: banner logo + colour palette.
#
# The graphical installer (cdebconf-gtk) reads two things from its own initrd:
#   * the banner at the top: usr/share/graphics/logo_installer.png + logo_debian.png
#   * a GTK+2 rc file (name: "gtkrc") that defines the colour scheme — the stock
#     beige/tan palette lives there.
# Both are baked into the installer initrd (install*/initrd.gz). We patch them
# HERE, in the binary/ tree, as a BINARY hook — which live-build runs during the
# binary stage BEFORE binary_iso assembles the ISO and BEFORE binary_checksums
# computes md5sum.txt. That is the crucial difference from editing the finished
# ISO with xorriso: doing it pre-assembly keeps the /install directory structure
# intact (editing the built ISO materialised /install and broke the path to
# vmlinuz -> "file /install/gtk/vmlinuz not found"), and the checksums are
# computed over the already-patched initrd so integrity still verifies.
#
# The banner asset is passed as an ABSOLUTE path via SYSIBLE_INSTALLER_BANNER
# (exported by build.sh) so it resolves no matter what CWD live-build gives the
# hook. Installer initrds are found by CONTENT (they contain the banner file), so
# this never depends on the exact d-i path, and the live-boot initrd — which has
# no such file — is skipped untouched. Best-effort: never fails the build; logs
# what it patched (or warns) so a future path/format change is diagnosable.
set -e

BANNER="${SYSIBLE_INSTALLER_BANNER:-}"
if [ -z "$BANNER" ] || [ ! -f "$BANNER" ]; then
    echo "sysible-installer-branding: banner asset not found (SYSIBLE_INSTALLER_BANNER='$BANNER') — skipping." >&2
    exit 0
fi
command -v cpio >/dev/null 2>&1 || { echo "sysible-installer-branding: cpio unavailable — skipping." >&2; exit 0; }

# --- Sysible GTK+2 palette for the graphical installer ---------------------
# Appended to the installer's own gtkrc. `widget "*"` / `class "*"` bound at
# `: highest` priority beat the stock theme's per-widget bindings, so this
# recolours every surface from the beige default to the Sysible dark-green brand.
# It only sets colours (no engine, no geometry) so it cannot break the installer:
# unparsed lines are ignored by GTK, and the g-i uses the default engine.
SYSIBLE_GTKRC='
# --- Sysible Server brand palette (appended last, highest priority) --------
style "sysible-brand" {
    bg[NORMAL]        = "#101b15"
    bg[PRELIGHT]      = "#1f9d55"
    bg[SELECTED]      = "#1f9d55"
    bg[ACTIVE]        = "#16261d"
    bg[INSENSITIVE]   = "#101b15"

    fg[NORMAL]        = "#e6efe9"
    fg[PRELIGHT]      = "#08130c"
    fg[SELECTED]      = "#08130c"
    fg[ACTIVE]        = "#e6efe9"
    fg[INSENSITIVE]   = "#6b7a70"

    base[NORMAL]      = "#0b1410"
    base[PRELIGHT]    = "#0b1410"
    base[SELECTED]    = "#1f9d55"
    base[ACTIVE]      = "#16261d"
    base[INSENSITIVE] = "#0b1410"

    text[NORMAL]      = "#e6efe9"
    text[PRELIGHT]    = "#e6efe9"
    text[SELECTED]    = "#08130c"
    text[ACTIVE]      = "#e6efe9"
    text[INSENSITIVE] = "#6b7a70"
}
class  "*" style : highest "sysible-brand"
widget "*" style : highest "sysible-brand"
'

patched=0
# CWD during a binary hook is not guaranteed, so search from '.' for any gzip
# initrd; the content probe below decides which are installer initrds.
for initrd in $(find . -type f -name 'initrd.gz' 2>/dev/null); do
    gzip -t "$initrd" 2>/dev/null || continue
    if ! gzip -dc "$initrd" 2>/dev/null | cpio -t --quiet 2>/dev/null \
         | grep -qE 'usr/share/graphics/logo_(installer|debian)\.png'; then
        continue    # not an installer initrd (e.g. the live-boot initrd) — leave it alone
    fi
    work=$(mktemp -d)
    gzip -dc "$initrd" 2>/dev/null | ( cd "$work" && cpio -idm --quiet 2>/dev/null ) || { rm -rf "$work"; continue; }

    # 1) banner logo -> Sysible Server wordmark
    for g in logo_installer.png logo_debian.png; do
        [ -e "$work/usr/share/graphics/$g" ] && cp -f "$BANNER" "$work/usr/share/graphics/$g"
    done

    # 2) colour palette -> append the Sysible brand style to every gtkrc the
    #    installer ships (path varies across d-i versions, so patch by name).
    gtkrc_hit=0
    for rc in $(cd "$work" && find . -type f -name 'gtkrc' 2>/dev/null); do
        printf '%s\n' "$SYSIBLE_GTKRC" >> "$work/${rc#./}"
        gtkrc_hit=$((gtkrc_hit + 1))
    done
    # Fallback: if the initrd shipped no gtkrc under a name we matched, drop one
    # at the canonical GTK+2 system path so it is still read.
    if [ "$gtkrc_hit" = 0 ]; then
        mkdir -p "$work/etc/gtk-2.0"
        printf '%s\n' "$SYSIBLE_GTKRC" >> "$work/etc/gtk-2.0/gtkrc"
        gtkrc_hit=1
    fi

    ( cd "$work" && find . | cpio -o -H newc --quiet 2>/dev/null | gzip -9 ) > "$initrd.new" \
        && mv -f "$initrd.new" "$initrd"
    rm -rf "$work"
    echo "sysible-installer-branding: rebranded $initrd (logo + $gtkrc_hit gtkrc)" >&2
    patched=$((patched + 1))
done

echo "sysible-installer-branding: rebranded $patched installer initrd(s)." >&2
if [ "$patched" = 0 ]; then
    echo "sysible-installer-branding: WARNING — no installer initrd carried the banner; the installer keeps Debian branding. Graphics found:" >&2
    for initrd in $(find . -type f -name 'initrd.gz' 2>/dev/null); do
        g="$(gzip -dc "$initrd" 2>/dev/null | cpio -t --quiet 2>/dev/null | grep -iE 'graphics|logo|\.png' | head)"
        [ -n "$g" ] && { echo "   --- $initrd ---" >&2; echo "$g" >&2; }
    done
fi
exit 0
