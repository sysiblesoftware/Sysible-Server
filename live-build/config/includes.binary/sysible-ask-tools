#!/bin/sh
# Sysible Server — ask which optional/licensed tools to add, DURING the
# Debian install and BEFORE the base system is laid down.
#
# Run from preseed/early_command (which executes right after the preseed is read,
# before partitioning and base-installer). We show a debconf multiselect; the
# answer is stashed in the installer's ramdisk at /tmp/sysible-tools.wanted.
# preseed/late_command then copies it into the target as /etc/sysible/tools.wanted,
# and the sysible-tools-firstboot.service oneshot installs the picks on first boot.
#
# Everything is guarded so a debconf hiccup can NEVER fail an otherwise-good
# install: worst case nothing is preselected and the operator uses `sysible-tools`
# after boot, exactly as before.
#
# NO `set -e` here — on purpose. This runs from d-i's preseed/early_command, where
# ANY non-zero exit aborts the install with a "Failed to run preseeded command"
# dialog. debconf's confmodule and the db_* commands routinely return non-zero as
# NORMAL control flow (a skipped question, an unset value, a template that didn't
# load), so `set -e` here turned a harmless debconf hiccup into a failed install.
# We run best-effort and force `exit 0` at the very end instead.
if [ ! -r /usr/share/debconf/confmodule ]; then
  # No debconf available this early — skip the prompt, never fail the install.
  : > /tmp/sysible-tools.wanted 2>/dev/null || true
  exit 0
fi
. /usr/share/debconf/confmodule 2>/dev/null || exit 0

# WHERE THE TEMPLATES ARE. The initrd root first, for the same reason the
# preseed runs us from there: at early_command time no media is mounted yet, so
# /cdrom/... is not available and debconf-loadtemplate would quietly load
# nothing -- leaving db_input with no template to show, which looks exactly like
# "the question was never asked". /cdrom and /hd-media remain for an hd-media
# install, where the ISO root copy is what exists.
for T in /sysible-tools.templates /cdrom/sysible-tools.templates /hd-media/sysible-tools.templates; do
  if [ -f "$T" ]; then
    debconf-loadtemplate sysible "$T" 2>/dev/null || true
    break
  fi
done

# critical priority so the question is shown even on an otherwise high-priority /
# mostly-preseeded install. If the template failed to load, db_input just no-ops.
db_input critical sysible/tools 2>/dev/null || true
db_go 2>/dev/null || true

RET=
db_get sysible/tools 2>/dev/null || RET=
# Parsed exactly like sysible/apps below: split on the comma, then take each
# choice's FIRST WORD as the id. The old line was `tr -d ' '` with no comma
# split -- it deleted every space and so could only ever work while the choices
# were bare names. The moment a choice carried explanatory text, as the apps
# question's already do and these now do, it would have produced
# "terraform(BUSL,notopensource)" and the first-boot installer would have
# rejected the lot. Same question, same shape, same parser.
TOOLS=$(printf '%s' "${RET:-}" \
        | tr ',' '\n' \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]].*$//' -e '/^$/d' \
        | tr '\n' ' ')
TOOLS=$(printf '%s' "$TOOLS" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
printf '%s' "$TOOLS" > /tmp/sysible-tools.wanted 2>/dev/null || true

# --- and which Sysible apps to set up ---------------------------------------
# Asked for as "on install it should ask to install slop". The apps were only
# ever installed by running `install-sysible` AFTER the install finished -- and
# on a headless server nothing says that exists. Same shape as the tools
# question above: ask here, record the answer, let the first networked boot do
# the work (cloning and container builds need a network this installer has no
# guarantee of).
db_input critical sysible/apps 2>/dev/null || true
db_go 2>/dev/null || true

# db_get sets $RET -- NOT a variable named after the question. The tools branch
# above reads $RET correctly; this one set APPS= and then read $APPS, which is
# empty forever. So the answer was collected and thrown away: the file was
# always written empty and the first boot reported "nothing selected", whatever
# had been chosen. That is why making this a checklist had to come with running
# the script instead of reading it.
RET=
db_get sysible/apps 2>/dev/null || RET=
APPS="${RET:-}"
# A multiselect answers "a, b, c". Each choice's FIRST WORD is the id
# install-sysible takes, so a choice can carry explanatory text -- "slop (all
# apps behind one gateway)" -- without the parsing changing. sed, not awk: this
# runs in the installer's busybox environment.
#
# The old line was `tr -d ' '` with no `tr ',' ' '` (which the tools question
# above DOES have), so the moment this became a multiselect it would have
# written "controller,slep" and install-sysible would have rejected it as one
# unknown product. The question was single-choice, so it never showed.
APPS=$(printf '%s' "${APPS:-}" \
       | tr ',' '\n' \
       | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]].*$//' -e '/^$/d' \
       | tr '\n' ' ')
# "slop" IS all three behind the gateway, so it supersedes the rest: installing
# it alongside controller/slep/connect would stand a second standalone copy of
# each next to the ones the gateway fronts.
case " $APPS " in
  *" slop "*) APPS="slop" ;;
esac
APPS=$(printf '%s' "$APPS" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
case "${APPS:-}" in
  ''|none) : > /tmp/sysible-apps.wanted 2>/dev/null || true ;;
  *)       printf '%s' "$APPS" > /tmp/sysible-apps.wanted 2>/dev/null || true ;;
esac
exit 0
