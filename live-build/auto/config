#!/bin/sh
# live-build configuration for the Sysible Server ISO.
set -e

# Architecture is parameterized (SYSIBLE_ARCH): amd64 (default) or arm64.
# amd64 gets the hybrid BIOS+UEFI bootloaders; arm64 is UEFI-only (there is no
# BIOS/isolinux for it), so it uses grub-efi alone.
ARCH="${SYSIBLE_ARCH:-amd64}"
if [ "$ARCH" = "arm64" ]; then
  BOOTLOADERS="grub-efi"
else
  BOOTLOADERS="syslinux,grub-efi"
fi

lb config noauto \
  --distribution "${SYSIBLE_CODENAME:-bookworm}" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures "$ARCH" \
  --bootloaders "$BOOTLOADERS" \
  --binary-images iso-hybrid \
  --debian-installer live \
  `# THE GRAPHICAL INSTALLER. Without this live-build never downloads it:`\
  `# lb_binary_debian-installer sets DOWNLOAD_GTK_INSTALLER=0 unless this is`\
  `# exactly "true". Nothing then produces install/gtk/initrd.gz, the`\
  `# branding hook fabricates that path by copying the TEXT initrd so the`\
  `# menu entry resolves, and "Install Sysible Server" booted newt -- the`\
  `# blue TUI, reported three times. live-build restricts the download to`\
  `# amd64/i386 itself. arm64 is NOT covered by this flag -- Debian ships a`\
  `# graphical installer for it (verified: cdrom/gtk/initrd.gz is 50,748,002`\
  `# bytes and carries etc/gtk-2.0/gtkrc) but live-build will not fetch it,`\
  `# so 9300-sysible-gtk-installer.hook.binary does.`\
  --debian-installer-gui true \
  --bootappend-live "boot=live components username=sysible user-fullname=Sysible user-default-groups=sudo,kvm,netdev" \
  --bootappend-install "file=/cdrom/preseed.cfg" \
  --iso-application "Sysible Server" \
  --iso-publisher "Sysible" \
  --iso-volume "Sysible Server" \
  --memtest none \
  "${@}"
