#!/usr/bin/make -f
CH := $(CURDIR)/../../live-build/config/includes.chroot
D  := $(CURDIR)/debian/sysible-branding

%:
	dh $@

override_dh_auto_build:

override_dh_auto_install:
	# GRUB boot theme — the Sysible green boot menu, the only branding a headless
	# server renders. The GDM login/lock background, the desktop app icons and the
	# pixmaps were removed with the GUI (Sysible Workstation has no desktop).
	install -d $(D)/boot/grub/themes
	cp -a $(CH)/boot/grub/themes/sysible $(D)/boot/grub/themes/
	# Sora brand font
	install -d $(D)/usr/share/fonts/truetype/sora
	cp -a $(CH)/usr/share/fonts/truetype/sora/. $(D)/usr/share/fonts/truetype/sora/
