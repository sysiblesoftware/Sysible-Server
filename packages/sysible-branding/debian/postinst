#!/bin/sh
set -e
case "$1" in
  configure)
    # Re-apply the GRUB boot theme and refresh the brand font cache. (The GDM
    # login-background and gtk icon-cache steps were dropped — Sysible Server is
    # headless, no desktop.)
    [ -x /usr/sbin/update-grub ] && update-grub >/dev/null 2>&1 || true
    command -v fc-cache >/dev/null 2>&1 && fc-cache -f /usr/share/fonts/truetype/sora >/dev/null 2>&1 || true
    ;;
esac
#DEBHELPER#
exit 0
